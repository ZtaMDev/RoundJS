    "round-core": "^0.1.8"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "shiki": "^1.0.0"
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/ZtaMDev/RoundJS.git"
  }
