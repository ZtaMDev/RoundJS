{
  "name": "@round-core/markdown",
  "version": "0.1.0",
  "description": "Markdown component for Round",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
